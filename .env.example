# ============================================================
# SUPABASE & DRIZZLE CONFIGURATION
# ============================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Database Connection (Supabase Connection Pooler - Session mode port 5432 for DDL/Migrations)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
DATABASE_POOLER_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# SANITY CMS CONFIGURATION (For upcoming phase)
# ============================================================
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-03-01
SANITY_WEBHOOK_SECRET=your_sanity_webhook_secret

# ============================================================
# EMAILJS CONFIGURATION
# ============================================================
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
